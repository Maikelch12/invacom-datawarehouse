table _Medidas
	lineageTag: 0b544ef5-1190-4229-bf35-4e21f32ac5f9

	measure 'Ventas Netas' = SUM ( fact_ventas[monto_neto] )
		formatString: #,0.00
		lineageTag: 30acd6c5-507e-4eee-8fb1-929d603dccb2

	measure 'Ventas Netas AA' =
			
			CALCULATE (
			    [Ventas Netas],
			    SAMEPERIODLASTYEAR ( dim_tiempo[fecha] )
			)
		formatString: #,0.00
		lineageTag: 75d8256a-d083-4fb0-ac09-47cbd59b756e

	measure 'Crecimiento YoY %' =
			
			VAR VentasActual = [Ventas Netas]
			VAR VentasAnioAnterior = [Ventas Netas AA]
			RETURN
			    DIVIDE ( VentasActual - VentasAnioAnterior, VentasAnioAnterior )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9266f89e-53de-44c8-aca9-e882e45b7082

	measure 'Ventas Mes Anterior' =
			
			CALCULATE (
			    [Ventas Netas],
			    PREVIOUSMONTH ( dim_tiempo[fecha] )
			)
		formatString: #,0.00
		lineageTag: 3745852c-5b80-44c6-9ea9-1eac6a17587f

	measure 'Variación MoM %' =
			
			VAR VentasActual = [Ventas Netas]
			VAR VentasMesAnterior = [Ventas Mes Anterior]
			RETURN
			    DIVIDE ( VentasActual - VentasMesAnterior, VentasMesAnterior )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 48528466-eef3-43ed-a628-fa7d91684660

	measure 'Color YoY' =
			
			VAR Valor = [Crecimiento YoY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Valor ), "#9CA3AF",
			        Valor >= 0.15, "#15803D",
			        Valor >= 0, "#B45309",
			        "#B91C1C"
			    )
		lineageTag: f6b053cf-06a0-4e07-984f-c5911444b07e

	measure 'Color MoM' =
			
			VAR Valor = [Variación MoM %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Valor ), "#9CA3AF",
			        Valor >= 0, "#15803D",
			        Valor >= -0.10, "#B45309",
			        "#B91C1C"
			    )
		lineageTag: 7b43363a-8077-4388-bc57-c80cbdf3450c

	measure Pedidos = DISTINCTCOUNT ( fact_ventas[pedido_id] )
		formatString: 0
		lineageTag: ce8e73a1-4091-4dd0-b056-662846d858f9

	measure 'Ticket Promedio' = DIVIDE ( [Ventas Netas], [Pedidos] )
		formatString: 0.00
		lineageTag: 2d200a6e-bd33-4a21-bff6-bfff4d5f6152

	measure 'Color Ticket' =
			
			VAR Valor = [Ticket Promedio]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Valor ), "#9CA3AF",
			        Valor >= 1500, "#15803D",
			        Valor >= 1300, "#B45309",
			        "#B91C1C"
			    )
		lineageTag: b50a877a-00e4-49c9-8e7d-1437ad9e90a8

	measure 'Clientes Activos' = DISTINCTCOUNT ( fact_ventas[cliente_key] )
		formatString: 0
		lineageTag: 3099fb50-1bb8-41b2-845b-00829975a348

	measure 'Clientes Recurrentes' =
			
			VAR InicioPeriodo = MIN ( dim_tiempo[fecha] )
			RETURN
			    COUNTROWS (
			        FILTER (
			            VALUES ( fact_ventas[cliente_key] ),
			            CALCULATE (
			                COUNTROWS ( fact_ventas ),
			                FILTER ( ALL ( dim_tiempo ), dim_tiempo[fecha] < InicioPeriodo )
			            ) > 0
			        )
			    )
		formatString: 0
		lineageTag: 77b4cb7f-51d1-45e4-bb70-81b0081fd2da

	measure 'Tasa Clientes Recurrentes' = DIVIDE ( [Clientes Recurrentes], [Clientes Activos] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: af688fd3-3fba-409d-86e3-72812eba52f4

	measure 'Color Recurrentes' =
			
			VAR Valor = [Tasa Clientes Recurrentes]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Valor ), "#9CA3AF",
			        Valor >= 0.90, "#15803D",
			        Valor >= 0.80, "#B45309",
			        "#B91C1C"
			    )
		lineageTag: 8e8405a4-307f-4de8-9abc-20e35ebcbfe5

	measure 'Tasa Recurrentes Promedio' =
			
			AVERAGEX (
			    FILTER (
			        VALUES ( dim_tiempo[anio_mes] ),
			        [Clientes Activos] > 0 && LEFT ( dim_tiempo[anio_mes], 4 ) >= "2014"
			    ),
			    [Tasa Clientes Recurrentes]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 76fae1fd-d06e-4bcf-bec1-24d942ba5fed

	measure 'Ventas Brutas' = SUM(fact_ventas[monto_bruto])
		formatString: #,0.00
		lineageTag: 662e73cd-9d18-417f-90d2-071a160f8c61

	measure 'Monto Descuento' = CALCULATE(SUM(fact_ventas[monto_descuento]), KEEPFILTERS(fact_ventas[monto_descuento] > 0))
		formatString: #,0.00
		lineageTag: f503a183-14d6-4edc-b49d-207881518da2

	measure 'Flete Total' = SUM(fact_pedidos[flete])
		formatString: #,0.00
		lineageTag: d47031cb-63a5-417b-9b42-125d413ae2e6

	measure 'Ventas Netas Pedidos' = SUM(fact_pedidos[monto_neto_pedido])
		formatString: #,0.00
		lineageTag: 0d00c583-ad04-4eb1-8fb0-d830d5b758ed

	measure 'Tasa de Descuento %' = DIVIDE([Monto Descuento], [Ventas Brutas])
		formatString: 0.00%
		lineageTag: 119621c6-4b7e-4f01-ba2d-6058173cc42b

	measure 'Flete sobre Ventas %' = DIVIDE([Flete Total], [Ventas Netas Pedidos])
		formatString: 0.00%
		lineageTag: f3c2b2ad-2d55-4562-99d4-143559843db8

	measure 'Color Descuento' = SWITCH(TRUE(), ISBLANK([Tasa de Descuento %]), "#9CA3AF", [Tasa de Descuento %] <= 0.06, "#15803D", [Tasa de Descuento %] <= 0.08, "#B45309", "#B91C1C")
		lineageTag: a8246ebf-fb2b-4026-bf91-e4ac0c007261

	measure 'Color Flete' = SWITCH(TRUE(), ISBLANK([Flete sobre Ventas %]), "#9CA3AF", [Flete sobre Ventas %] <= 0.05, "#15803D", [Flete sobre Ventas %] <= 0.06, "#B45309", "#B91C1C")
		lineageTag: 5ef67b56-9ea9-4fa9-aa2f-efe9d8bac2d3

	measure '% Entregas a Tiempo' = AVERAGE ( fact_pedidos[entregado_a_tiempo] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: d7e71d9a-0fa8-48b7-a115-6fadcd43bb85

	measure 'Pedidos Tarde' = CALCULATE ( COUNTROWS ( fact_pedidos ), FILTER ( fact_pedidos, NOT ISBLANK ( fact_pedidos[entregado_a_tiempo] ) && fact_pedidos[entregado_a_tiempo] = 0 ) )
		formatString: 0
		lineageTag: b501bd3c-3a2b-4f8f-b484-e8ebb9bc96cb

	measure 'Meta Entregas' = 0.95
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 71e47a40-5101-4dc1-b830-821f799017e2

	measure 'Color Entregas' = SWITCH ( TRUE (), ISBLANK ( [% Entregas a Tiempo] ), "#9CA3AF", [% Entregas a Tiempo] >= 0.95, "#15803D", [% Entregas a Tiempo] >= 0.90, "#B45309", "#B91C1C" )
		lineageTag: 5aaa4fdd-ef90-4943-9b2a-0f3bca25626e

	measure 'Días Promedio Despacho' = CALCULATE ( AVERAGE ( fact_pedidos[dias_despacho] ), USERELATIONSHIP ( fact_pedidos[fecha_envio_key], dim_tiempo[tiempo_key] ) )
		formatString: 0.00
		lineageTag: 402c01ea-f845-488a-8496-42ad81a38780

	measure 'Meta Días' = 8
		formatString: 0
		lineageTag: c879f901-6e5e-4bcd-bbf2-d1a82218de95

	measure 'Color Días' = SWITCH ( TRUE (), ISBLANK ( [Días Promedio Despacho] ), "#9CA3AF", [Días Promedio Despacho] <= 8, "#15803D", [Días Promedio Despacho] <= 10, "#B45309", "#B91C1C" )
		lineageTag: 836485bc-6f20-4e97-8ab6-a94e53c5c1a1

	measure 'Gauge K5 Min' = 0
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 9a3db9d7-aaa9-4d26-82ca-008d74515867

	measure 'Gauge K5 Max' = 100
		formatString: 0
		lineageTag: 262576c2-5c7b-4525-a7bc-dd006b31b1dc

	measure 'Gauge K5 Alerta' = 90
		formatString: 0
		lineageTag: 17afbfc7-d4e6-4631-9546-ad66564a9ac2

	measure 'Gauge K5 Porcentaje' = [% Entregas a Tiempo] * 100
		formatString: 0.00
		lineageTag: d4e52174-3258-4b6c-a944-067e1c802e5b

	measure 'Gauge K5 Meta' = 95
		formatString: 0
		lineageTag: 0f837f18-6956-47c3-a365-378d684340d8

	measure 'Gauge K6 Min' = 0
		formatString: 0
		lineageTag: 015d6ee6-0288-473a-a20e-b7ef03bf4f59

	measure 'Gauge K6 Max' = 12
		formatString: 0
		lineageTag: 3ec0c7a8-abde-48ca-8c00-07fff6a0e029

	measure 'Pedidos Enviados KPI' = COUNT(fact_pedidos[entregado_a_tiempo])
		formatString: 0
		lineageTag: e0ca48ed-ad83-4df4-a31a-15627c766023

	measure 'Resultado K1' = CALCULATE([Crecimiento YoY %], KEEPFILTERS(dim_tiempo[anio_mes] = "2015-04"))
		formatString: 0.00%
		lineageTag: 2bcc30ca-cf6d-45d1-9e35-c466b655574c

	measure 'Meta K1' = 0.15
		formatString: 0.00%
		lineageTag: 53db3b8c-f266-4695-ab1e-e79dc4d8bb01

	measure 'Estado K1' = IF(ISBLANK([Resultado K1]), "SIN DATOS", IF([Resultado K1] >= [Meta K1], "CUMPLE LA META", "NO CUMPLE LA META"))
		lineageTag: d167b943-8bce-4c30-ae95-05a51058eb8b

	measure 'Color Estado K1' = IF(ISBLANK([Resultado K1]), "#9CA3AF", IF([Resultado K1] >= [Meta K1], "#15803D", "#B45309"))
		lineageTag: 3f6e9dd0-67b3-4502-8cc5-bee274183e3b

	measure 'Resultado K2' = CALCULATE([Variación MoM %], KEEPFILTERS(dim_tiempo[anio_mes] = "2015-04"))
		formatString: 0.00%
		lineageTag: 5b811184-683a-4ebb-936b-d865bc570c02

	measure 'Meta K2' = 0
		formatString: 0.00%
		lineageTag: 228df3ed-d856-4255-a514-bff32e4ab902

	measure 'Estado K2' = IF(ISBLANK([Resultado K2]), "SIN DATOS", IF([Resultado K2] >= [Meta K2], "CUMPLE LA META", "NO CUMPLE LA META"))
		lineageTag: 7d27301e-11cd-4e70-b2cc-d34cc140f82f

	measure 'Color Estado K2' = IF(ISBLANK([Resultado K2]), "#9CA3AF", IF([Resultado K2] >= [Meta K2], "#15803D", "#B45309"))
		lineageTag: fec21f9b-3b39-4efd-8c5d-93c96b5ba785

	measure 'Resultado K3' = [Ticket Promedio]
		formatString: #,0.00
		lineageTag: 453b1bf5-8d78-4874-abf4-c23a4a1e871c

	measure 'Meta K3' = 1500
		formatString: #,0.00
		lineageTag: 7c103bb2-442a-488c-a69e-7acee12e12a4

	measure 'Estado K3' = IF(ISBLANK([Resultado K3]), "SIN DATOS", IF([Resultado K3] >= [Meta K3], "CUMPLE LA META", "NO CUMPLE LA META"))
		lineageTag: ecee4d0b-f7fe-4b56-8319-5a5a26a97ed3

	measure 'Color Estado K3' = IF(ISBLANK([Resultado K3]), "#9CA3AF", IF([Resultado K3] >= [Meta K3], "#15803D", "#B45309"))
		lineageTag: 86bda4dd-6e07-41d5-a487-a9ae7526504a

